{
  "name": "grupo-kuwago-landing",
  "version": "0.1.0",
  "private": true,
  "description": "Provisional public landing page for Grupo Kuwago.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "npm run css && node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test:assets": "node --test scripts/test-asset-versioning.mjs",
    "test:loader": "node --test scripts/test-loader.mjs",
    "test:pwa": "node --test scripts/test-pwa.mjs scripts/test-pwa-install.mjs",
    "css": "tailwindcss -i styles/tailwind.input.css -o assets/css/tailwind.css --minify"
  },
  "devDependencies": {
    "tailwindcss": "3.4.19"
  }
}
