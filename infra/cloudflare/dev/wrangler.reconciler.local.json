{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kuwago-catalog-reconciler-local-only",
  "main": "src/reconciler.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "send_metrics": false,
  "dev": {
    "ip": "127.0.0.1",
    "port": 8793
  },
  "env": {
    "development": {
      "d1_databases": [
        {
          "remote": false,
          "binding": "DB",
          "database_name": "kuwago-admin-db-development"
        }
      ],
      "vars": {
        "APP_ENV": "development"
      },
      "preview_urls": false,
      "routes": [],
      "workers_dev": false,
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      },
      "name": "kuwago-catalog-reconciler-local-only-development",
      "r2_buckets": [
        {
          "remote": false,
          "binding": "PUBLICATION",
          "bucket_name": "kuwago-publication-local-development"
        },
        {
          "remote": false,
          "binding": "PRIVATE_MEDIA",
          "bucket_name": "kuwago-media-development"
        }
      ]
    }
  }
}
