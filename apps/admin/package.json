    "test": "vitest run",
    "verify:isolation": "node scripts/verify-isolation.mjs",
    "pretypecheck": "npm --prefix ../../packages/contracts run build",
    "predev": "npm --prefix ../../packages/contracts run build",
    "pretest": "npm --prefix ../../packages/contracts run build",
    "dev:local-test": "node scripts/dev-local-test.mjs",
    "test:e2e:local": "node scripts/e2e-local.mjs"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "5.3.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@kuwago/contracts": "file:../../packages/contracts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
