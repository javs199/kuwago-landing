Options -Indexes
DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<FilesMatch "^(index\.html|concierge-marketplace\.html|manifest\.webmanifest|sw\.js|pwa(?:-install(?:-state)?)?\.js|pwa-install\.css)$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.grupokuwago\.com$ [NC]
  RewriteRule ^ https://grupokuwago.com%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "^(index\.html|concierge-marketplace\.html|manifest\.webmanifest|sw\.js|pwa(?:-install(?:-state)?)?\.js|pwa-install\.css)$">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
    Header always unset Expires
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
</IfModule>
